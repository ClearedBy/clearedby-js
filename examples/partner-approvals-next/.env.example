# Your partner key, from ClearedBy. SERVER ONLY — never prefix it with NEXT_PUBLIC_.
CLEAREDBY_PARTNER_KEY=cb_partner_...
# Optional (defaults to https://app.clearedby.com).
# CLEAREDBY_BASE_URL=http://localhost:3000

