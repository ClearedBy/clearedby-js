{
  "name": "@clearedby/mcp",
  "version": "0.0.3",
  "description": "ClearedBy MCP server — request_clearance, check_policy, get_ledger from any MCP client.",
  "license": "MIT",
  "homepage": "https://clearedby.com",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "clearedby-mcp": "./src/index.ts"
  },
  "files": [
