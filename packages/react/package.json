{
  "name": "@clearedby/react",
  "version": "0.1.0",
  "description": "Drop-in approval UI for React: review queue, plain-English review panel, decision buttons, approval rules and history, styled by your design system and talking to your own backend proxy.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "clearedby-react": "./bin/clearedby-react.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./theme": {
      "types": "./src/theme-import.ts",
      "import": "./src/theme-import.ts"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "bin",
    "styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "clearedby",
    "approval",
    "human-in-the-loop",
    "react",
    "review-queue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClearedBy/clearedby-js.git",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./theme": {
        "types": "./dist/theme-import.d.ts",
        "import": "./dist/theme-import.js"
      },
      "./styles.css": "./styles.css"
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
