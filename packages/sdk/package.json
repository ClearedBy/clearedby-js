{
  "name": "@clearedby/sdk",
  "version": "0.1.0",
  "description": "Official ClearedBy SDK — gate agent actions, wait for human review, and run the whole org + partner API.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./receipt": {
      "types": "./src/receipt.ts",
      "import": "./src/receipt.ts"
    },
    "./dispatch": {
      "types": "./src/dispatch.ts",
      "import": "./src/dispatch.ts"
    },
    "./partner-proxy": {
      "types": "./src/partner-proxy.ts",
      "import": "./src/partner-proxy.ts"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "keywords": ["clearedby", "approval", "human-in-the-loop", "agent", "guardrails"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClearedBy/clearedby-js.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./receipt": {
        "types": "./dist/receipt.d.ts",
        "import": "./dist/receipt.js"
      },
      "./dispatch": {
        "types": "./dist/dispatch.d.ts",
        "import": "./dist/dispatch.js"
      },
      "./partner-proxy": {
        "types": "./dist/partner-proxy.d.ts",
        "import": "./dist/partner-proxy.js"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
