{
  "name": "@clearedby/sdk",
  "version": "0.0.4",
  "description": "Official ClearedBy SDK — gate agent actions, wait for human review, guard a function.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist"],
  "sideEffects": false,
  "keywords": ["clearedby", "approval", "human-in-the-loop", "agent", "guardrails"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClearedBy/clearedby-js.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
